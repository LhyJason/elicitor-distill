# Site settings for the Slurm scripts. Copy to cluster/local.env (untracked) and fill in.
SLURM_ACCOUNT=your_account
SLURM_PARTITION=your_gpu_partition
# Modules to load; leave empty if python3.12 and ollama are already on PATH.
PYTHON_MODULE=python/3.12
OLLAMA_MODULE=ollama
# Where Ollama finds the teachers (a shared read-only folder works).
OLLAMA_MODELS=$HOME/.ollama/models
# Per-group model folders (SPEC Q9). Unset, both groups use OLLAMA_MODELS. From M2 on the agent
# group serves the students, which live in a writable folder of their own (cluster/train.sbatch
# needs it):
# AGENT_OLLAMA_MODELS=$HOME/.ollama/models
# USER_OLLAMA_MODELS=$OLLAMA_MODELS
# M2 (cluster/train.sbatch): the base weights, one folder per model as `hf download
# Qwen/Qwen3-1.7B --local-dir $HF_DIR/Qwen3-1.7B` writes it, and a llama.cpp checkout for the
# GGUF conversion.
# HF_DIR=$HOME/hf
# LLAMA_CPP=$HOME/llama.cpp
